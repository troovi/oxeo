{
  "name": "@oxeo/visual",
  "version": "0.2.0",
  "description": "Интерактивная карта схемы данных oxeo: модели, поля, embedded-блоки и связи по исходникам схемы.",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oxeo-visual": "bin/oxeo-visual.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "echo": "echo \"@oxeo/visual\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "libavoid-js": "0.4.5",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "ts-node": ">=10"
  },
  "peerDependenciesMeta": {
    "ts-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "*"
  }
}
