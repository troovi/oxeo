{
  "name": "@oxeo/visual",
  "version": "0.3.0",
  "description": "Интерактивная карта схемы данных oxeo и страница операций: модели, поля, связи, операции доменов и их доступ.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/troovi/oxeo.git",
    "directory": "tools/visual"
  },
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oxeo-visual": "bin/oxeo-visual.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "echo": "echo \"@oxeo/visual\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run"
  },
  "dependencies": {
    "libavoid-js": "0.4.5",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "@oxeo/scheme": ">=0.6.0",
    "ts-node": ">=10"
  },
  "peerDependenciesMeta": {
    "@oxeo/scheme": {
      "optional": true
    },
    "ts-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oxeo/scheme": "file:../../core/scheme",
    "@types/node": "*",
    "vitest": "^4.1.12",
    "zod": "^4.3.6"
  }
}
