{
  "name": "@oxeo/server",
  "version": "0.2.0",
  "description": "Сервер oxeo: целостность схемы, журнал операций и договор драйвера, без конкретных драйверов и фреймворка",
  "main": "dist/index.js",
  "types": "./lib/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
