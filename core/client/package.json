{
  "name": "@oxeo/client",
  "version": "0.5.0",
  "description": "Клиент oxeo: живая часть базы сервера, чтения, пакеты запросов, очередь событий и вызовы операций",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/troovi/oxeo.git",
    "directory": "core/client"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "./lib/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "echo": "echo \"@oxeo/client.\"",
    "build": "rm -rf dist && rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript --bundleConfigAsCjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@oxeo/scheme": "file:../scheme",
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@oxeo-drivers/memory": "file:../../drivers/memory",
    "@oxeo/server": "file:../server",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-strip": "^3.0.4",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "rollup": "^4.18.1",
    "rollup-plugin-auto-external": "^2.0.0",
    "vitest": "^3.2.4"
  }
}
